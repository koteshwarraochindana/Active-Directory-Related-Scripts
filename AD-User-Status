# Prerequisites: Run once in an administrative PowerShell prompt if not already installed:
# Install-Module ImportExcel -Force -AllowClobber

Import-Module ActiveDirectory
Import-Module ImportExcel

# Configuration Paths
$userFile = "C:\temp\users.txt"
$excelPath = "C:\temp\results.xlsx"
$domains = @("adhcscint.net", "prd.hcscad.net")

# Verify input file exists
if (-not (Test-Path $userFile)) {
    Write-Error "Input file not found at $userFile"
    return
}

$users = Get-Content $userFile | Where-Object { $_ -match '\S' } # Cleans empty lines
$results = @()

foreach ($user in $users) {
    # Check each domain independently without short-circuiting via 'break'
    foreach ($domain in $domains) {
        $found = $null
        try {
            # Use an explicit filter to match standard Identity fields, UserPrincipalNames, or email addresses
            $found = Get-ADUser -Server $domain -Filter "SamAccountName -eq '$user' -or UserPrincipalName -eq '$user' -or mail -eq '$user'" -Properties Enabled, LastLogonDate, DistinguishedName -ErrorAction Stop
        } catch {
            # Catch connectivity or syntax errors silently to keep loop moving
        }
        
        if ($null -ne $found) {
            $results += [PSCustomObject]@{
                SearchInput       = $user
                SAMAccountName    = $found.SamAccountName
                Domain            = $domain
                Status            = if ($found.Enabled) { "Enabled" } else { "Disabled" }
                LastLogonDate     = if ($found.LastLogonDate) { $found.LastLogonDate.ToString() } else { "Never Logged On" }
                DistinguishedName = $found.DistinguishedName
            }
        } else {
            $results += [PSCustomObject]@{
                SearchInput       = $user
                SAMAccountName    = "N/A"
                Domain            = "$domain (Not Found)"
                Status            = "Absent"
                LastLogonDate     = "N/A"
                DistinguishedName = "N/A"
            }
        }
    }
}

# Split the master dataset safely by targeted domains
$tab1 = $results | Where-Object { $_.Domain -eq "adhcscint.net" -or $_.Domain -eq "adhcscint.net (Not Found)" }
$tab2 = $results | Where-Object { $_.Domain -eq "prd.hcscad.net" -or $_.Domain -eq "prd.hcscad.net (Not Found)" }

# Remove older spreadsheet if it exists to overwrite cleanly
if (Test-Path $excelPath) { Remove-Item $excelPath -Force }

# Output data cleanly to individual multi-sheets
$tab1 | Export-Excel -Path $excelPath -WorksheetName "adhcscint.net" -AutoSize
$tab2 | Export-Excel -Path $excelPath -WorksheetName "prd.hcscad.net" -AutoSize

Write-Host "Process completed successfully. Results saved to $excelPath" -ForegroundColor Green
