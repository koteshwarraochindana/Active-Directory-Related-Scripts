Import-Module ActiveDirectory

$users = Get-Content "C:\temp\users.txt"
$domains = @("adhcscint.net", "prd.hcscad.net")

$results = @()

foreach ($user in $users) {

    $found = $null
    $foundDomain = $null

    foreach ($domain in $domains) {
        try {
            $found = Get-ADUser -Server $domain -Identity $user -Properties Enabled, LastLogonDate, DistinguishedName -ErrorAction Stop
            $foundDomain = $domain
            break
        }
        catch {}
    }

    if ($null -eq $found) {
        $results += [PSCustomObject]@{
            User              = $user
            Domain            = "Not in AD"
            Enabled           = "Not in AD"
            LastLogonDate     = "N/A"
            DistinguishedName = "N/A"
        }
    }
    else {
        $results += [PSCustomObject]@{
            User              = $user
            Domain            = $foundDomain
            Enabled           = if ($found.Enabled) { "Enabled" } else { "Disabled" }
            LastLogonDate     = $found.LastLogonDate
            DistinguishedName = $found.DistinguishedName
        }
    }
}

$tab1 = $results | Where-Object { $_.Domain -eq "adhcscint.net" -or $_.Domain -eq "Not in AD" }
$tab2 = $results | Where-Object { $_.Domain -eq "prd.hcscad.net" }

$path = "C:\temp\results.xlsx"

$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$wb = $excel.Workbooks.Add()

# ✅ Delete extra default sheets safely (keep one)
while ($wb.Sheets.Count -gt 1) {
    $wb.Sheets.Item(1).Delete()
}

function Add-Sheet($wb, $name, $data) {

    $ws = $wb.Sheets.Item(1)
    $ws.Name = $name

    $headers = $data[0].PSObject.Properties.Name

    for ($i=0; $i -lt $headers.Count; $i++) {
        $ws.Cells.Item(1, $i+1) = $headers[$i]
    }

    for ($r=0; $r -lt $data.Count; $r++) {
        for ($c=0; $c -lt $headers.Count; $c++) {
            $ws.Cells.Item($r+2, $c+1) = $data[$r].($headers[$c])
        }
    }

    $ws.Columns.AutoFit() | Out-Null
}

# First sheet
Add-Sheet $wb "adhcscint.net" $tab1

# Add second sheet properly
$ws2 = $wb.Sheets.Add()
$ws2.Name = "prd.hcscad.net"

$headers = $tab2[0].PSObject.Properties.Name

for ($i=0; $i -lt $headers.Count; $i++) {
    $ws2.Cells.Item(1, $i+1) = $headers[$i]
}

for ($r=0; $r -lt $tab2.Count; $r++) {
    for ($c=0; $c -lt $headers.Count; $c++) {
        $ws2.Cells.Item($r+2, $c+1) = $tab2[$r].($headers[$c])
    }
}

$ws2.Columns.AutoFit() | Out-Null

$wb.SaveAs($path)
$wb.Close()
$excel.Quit()

[System.Runtime.Interopservices.Marshal]::ReleaseComObject($excel) | Out-Null

Write-Host "Saved to $path"
