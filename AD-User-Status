Import-Module ActiveDirectory
Import-Module ImportExcel

# Configuration Paths
$userFile = "C:\temp\users.txt"
$excelPath = "C:\temp\results.xlsx"
$domains = @("adhcscint.net", "prd.hcscad.net")

# Verify input file exists
if (-not (Test-Path $userFile)) {
    Write-Error "Input file not found at $userFile"
    return
}

$users = Get-Content $userFile | Where-Object { $_ -match '\S' } # Cleans empty lines
$results = @()

foreach ($user in $users) {
    $bestMatch = $null
    $matchedDomain = "N/A"
    
    # Internal scan across all domains for the current user
    foreach ($domain in $domains) {
        try {
            $found = Get-ADUser -Server $domain -Filter "SamAccountName -eq '$user' -or UserPrincipalName -eq '$user' -or mail -eq '$user'" -Properties Enabled, LastLogonDate, DistinguishedName -ErrorAction Stop
            
            if ($null -ne $found) {
                # Prioritization Rules: 
                # 1. If we haven't found anything yet, grab this record (even if disabled).
                # 2. If we previously found a disabled record, but THIS domain has an ENABLED record, overwrite it.
                if ($null -eq $bestMatch -or (-not $bestMatch.Enabled -and $found.Enabled)) {
                    $bestMatch = $found
                    $matchedDomain = $domain
                }
            }
        } catch {
            # Safely skip offline domains or errors to keep processing the input list
        }
    }
    
    # Output exactly ONE row per input user line
    if ($null -ne $bestMatch) {
        $results += [PSCustomObject]@{
            "Search Input"       = $user
            "SAM Account Name"   = $bestMatch.SamAccountName
            "Target Domain"      = $matchedDomain
            "AD Status"          = if ($bestMatch.Enabled) { "Enabled" } else { "Disabled" }
            "Last Logon Date"    = if ($bestMatch.LastLogonDate) { $bestMatch.LastLogonDate.ToString() } else { "Never Logged On" }
            "Distinguished Name" = $bestMatch.DistinguishedName
        }
    } else {
        # Handles the "Not Found" scenario perfectly to preserve a 1-to-1 line count
        $results += [PSCustomObject]@{
            "Search Input"       = $user
            "SAM Account Name"   = "N/A"
            "Target Domain"      = "Not Found"
            "AD Status"          = "Absent"
            "Last Logon Date"    = "N/A"
            "Distinguished Name" = "N/A"
        }
    }
}

# Remove older spreadsheet if it exists to overwrite cleanly
if (Test-Path $excelPath) { Remove-Item $excelPath -Force }

# Export to a single sheet with automatically sized columns
$results | Export-Excel -Path $excelPath -WorksheetName "AD Status Report" -AutoSize

Write-Host "Process completed successfully. Exactly $($results.Count) lines saved to $excelPath" -ForegroundColor Green
